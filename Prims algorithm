def prim(graph):
    n = len(graph)
    selected = [False] * n
    selected[0] = True
    edges = 0
    cost = 0

    print("Edges in MST:")

    while edges < n - 1:
        minimum = float('inf')
        x = y = 0

        for i in range(n):
            if selected[i]:
                for j in range(n):
                    if not selected[j] and graph[i][j] != 0:
                        if graph[i][j] < minimum:
                            minimum = graph[i][j]
                            x, y = i, j

        print(x, "-", y, ":", minimum)
        cost += minimum
        selected[y] = True
        edges += 1

    print("Minimum Cost =", cost)


graph = [
    [0, 2, 3, 0],
    [2, 0, 1, 4],
    [3, 1, 0, 5],
    [0, 4, 5, 0]
]

prim(graph)
