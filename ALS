def assembly_line(a, t, e, x, n):

    # DP arrays
    T1 = [0] * n
    T2 = [0] * n

    # Entry time + first station processing time
    T1[0] = e[0] + a[0][0]
    T2[0] = e[1] + a[1][0]

    # Calculate minimum time for each station
    for i in range(1, n):

        T1[i] = min(
            T1[i - 1] + a[0][i],
            T2[i - 1] + t[1][i - 1] + a[0][i]
        )

        T2[i] = min(
            T2[i - 1] + a[1][i],
            T1[i - 1] + t[0][i - 1] + a[1][i]
        )

    # Add exit times
    answer = min(
        T1[n - 1] + x[0],
        T2[n - 1] + x[1]
    )

    return answer


# Processing times
a = [
    [4, 5, 3, 2],
    [2, 10, 1, 4]
]

# Transfer times
t = [
    [0, 7, 4, 5],
    [0, 9, 2, 8]
]

# Entry times
e = [10, 12]

# Exit times
x = [18, 7]

# Number of stations
n = 4

minimum_time = assembly_line(a, t, e, x, n)

print("Minimum time =", minimum_time)
