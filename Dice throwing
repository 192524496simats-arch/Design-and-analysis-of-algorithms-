def dice_throw(n, m, target):
    # dp[i][j] = number of ways to get sum j using i dice
    dp = [[0] * (target + 1) for _ in range(n + 1)]

    dp[0][0] = 1

    for i in range(1, n + 1):
        for j in range(1, target + 1):
            for face in range(1, m + 1):
                if j >= face:
                    dp[i][j] += dp[i - 1][j - face]

    return dp[n][target]


# Input
n = int(input("Enter number of dice: "))
m = int(input("Enter number of faces: "))
target = int(input("Enter target sum: "))

# Output
print("Number of ways =", dice_throw(n, m, target))
